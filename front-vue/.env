# 页面标题（用于vitePlugin_html进行注入）
VITE_APP_TITLE="无限进步"
VITE_APP_DESCRIPTION="VITE_APP_DESCRIPTION"
VITE_APP_KEYWORDS="VITE_APP_KEYWORDS"
#服务端口
VITE_PORT=8888
# 路由懒加载
VITE_CLI_BABEL_TRANSPILE_MODULES=true
# 是否开启代理
VITE_OPEN_PROXY=false
VITE_PROXY_URL=http://localhost
# 接口前缀修饰
VITE_API_PREFIX=/api
# 接口地址
VITE_API_BASE_URL='http://localhost:8888'
# TOKEN名称
VITE_REQUEST_HEADER_TOKEN='token'

